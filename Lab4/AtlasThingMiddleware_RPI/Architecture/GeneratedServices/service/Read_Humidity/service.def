autogen definitions service;
library = "#include <wiringPi.h>";
output = { name = Returns_humidity; type = "int"; };
name = Read_Humidity;
source = "#define DHT_PIN      17";
source = "#define DHT_ATTEMPTS 3";
source = "#define DHT_RETRY_MS 1100";
source = "/* DHT11 read, inlined: Atlas has no shared helpers between services */";
source = "unsigned char data[5];";
source = "int ok = 0;";
source = "int levels[4] = { HIGH, LOW, HIGH, LOW };";
source = "unsigned int limits[4] = { 100, 100, 120, 120 };";
source = "wiringPiSetupGpio();";
source = "for (int attempt = 0; attempt < DHT_ATTEMPTS && !ok; attempt++) {";
source = "    if (attempt > 0) delay(DHT_RETRY_MS);";
source = "    for (int k = 0; k < 5; k++) data[k] = 0;";
source = "    /* wake-up pulse: hold the line LOW for 20 ms, then release it */";
source = "    pinMode(DHT_PIN, OUTPUT);";
source = "    digitalWrite(DHT_PIN, LOW);";
source = "    delay(20);";
source = "    pinMode(DHT_PIN, INPUT);";
source = "    pullUpDnControl(DHT_PIN, PUD_UP);";
source = "    /* handshake: the sensor answers LOW 80 us then HIGH 80 us */";
source = "    int good = 1;";
source = "    for (int s = 0; s < 4 && good; s++) {";
source = "        unsigned int t0 = micros();";
source = "        while (good && digitalRead(DHT_PIN) != levels[s]) {";
source = "            if (micros() - t0 > limits[s]) good = 0;";
source = "        }";
source = "    }";
source = "    /* 40 data bits: a HIGH pulse longer than 50 us is a 1 */";
source = "    for (int i = 0; i < 40 && good; i++) {";
source = "        unsigned int t0 = micros();";
source = "        while (good && digitalRead(DHT_PIN) != HIGH) {";
source = "            if (micros() - t0 > 100) good = 0;";
source = "        }";
source = "        unsigned int start = micros();";
source = "        while (good && digitalRead(DHT_PIN) != LOW) {";
source = "            if (micros() - start > 120) good = 0;";
source = "        }";
source = "        unsigned int duration = micros() - start;";
source = "        data[i / 8] = data[i / 8] << 1;";
source = "        if (duration > 50) data[i / 8] = data[i / 8] | 1;";
source = "    }";
source = "    /* the fifth byte is the checksum of the first four */";
source = "    if (good && ((data[0] + data[1] + data[2] + data[3]) & 0xFF) == data[4]) ok = 1;";
source = "}";
source = "/* data[0] is the integer part of the relative humidity in percent; -1 = read failed */";
source = "Returns_humidity = ok ? data[0] : -1;";
