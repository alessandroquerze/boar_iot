autogen definitions service;
library = "#include <wiringPi.h>";
output = { name = Returns_humidity; type = "int"; };
name = Read_Humidity;
source = "#define DHT_PIN    17";
source = "unsigned char data[5] = { 0 };";
source = "wiringPiSetupGpio();";
source = "pinMode(DHT_PIN, OUTPUT);";
source = "digitalWrite(DHT_PIN, LOW);";
source = "delay(20);";
source = "pinMode(DHT_PIN, INPUT);";
source = "pullUpDnControl(DHT_PIN, PUD_UP);";
source = "for (int i = 0; i < 40; i++) {";
source = "    if (!wait_level(HIGH, 100))";
source = "    unsigned int start = micros();";
source = "    if (!wait_level(LOW, 120))";
source = "    unsigned int duration = micros() - start;";
source = "    data[i / 8] <<= 1;";
source = "    if (duration > 50)";
source = "        data[i / 8] |= 1;";
source = "}";
source = "unsigned char checksum = (data[0] + data[1] + data[2] + data[3]) & 0xFF;";
source = "if (checksum != data[4])";
source = "*humidity = data[0];";
source = "*temperature = data[2];";
