autogen definitions service;
library = "#include <wiringPi.h>";
output = { name = Calibrates_the_sensor; type = "int"; };
name = Calibrate_Sensor;
source = "wiringPiSetupGpio();";
source = "int dhtPin = 17;";
source = "for (int attempt = 0; attempt < 3; attempt++) {";
source = "    if (attempt > 0) delay(1100);";
source = "    pinMode(dhtPin, OUTPUT);";
source = "    digitalWrite(dhtPin, LOW);";
source = "    delay(20);";
source = "    pinMode(dhtPin, INPUT);";
source = "    pullUpDnControl(dhtPin, PUD_UP);";
source = "    ";
source = "    unsigned int t_start = micros();";
source = "    while (digitalRead(dhtPin) == LOW) {";
source = "        if ((micros() - t_start) > 100) break;";
source = "    }";
source = "    t_start = micros();";
source = "    while (digitalRead(dhtPin) == HIGH) {";
source = "        if ((micros() - t_start) > 100) break;";
source = "    }";
source = "    ";
source = "    unsigned char dht_data[5] = {0, 0, 0, 0, 0};";
source = "    bool valid = true;";
source = "    for (int i = 0; i < 40; i++) {";
source = "        t_start = micros();";
source = "        while (digitalRead(dhtPin) == LOW) {";
source = "            if ((micros() - t_start) > 100) { valid = false; break; }";
source = "        }";
source = "        unsigned int pulse_start = micros();";
source = "        while (digitalRead(dhtPin) == HIGH) {";
source = "            if ((micros() - pulse_start) > 120) { valid = false; break; }";
source = "        }";
source = "        if (!valid) break;";
source = "        dht_data[i / 8] <<= 1;";
source = "        if ((micros() - pulse_start) > 50) dht_data[i / 8] |= 1;";
source = "    }";
source = "    if (valid && ((dht_data[0] + dht_data[1] + dht_data[2] + dht_data[3]) & 0xFF) == dht_data[4]) {";
source = "    }";
source = "}";
