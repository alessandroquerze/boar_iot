autogen definitions service;
library = "#include <wiringPi.h>";
output = { name = Window_angle; type = "int"; };
name = Set_Window;
source = "#define SERVO_PIN        18";
source = "#define SERVO_CLOSED_PWM 150";
source = "#define WINDOW_MAX_ANGLE 50";
source = "#define SERVO_TICKS_180  200";
source = "#define PWM_CLOCK  192";
source = "#define PWM_RANGE  2000";
source = "if (angle < 0) angle = 0;";
source = "if (angle > WINDOW_MAX_ANGLE) angle = WINDOW_MAX_ANGLE;";
source = "wiringPiSetupGpio();";
source = "pinMode(SERVO_PIN, PWM_OUTPUT);";
source = "pwmSetMode(PWM_MODE_MS);";
source = "pwmSetClock(PWM_CLOCK);";
source = "pwmSetRange(PWM_RANGE);";
source = "pwmWrite(SERVO_PIN, SERVO_CLOSED_PWM + (angle * SERVO_TICKS_180) / 180);";
source = "FILE* f = fopen(\"/tmp/window_angle\", \"w\");";
source = "if (f != nullptr) {";
source = "    fprintf(f, \"%d\", angle);";
source = "    fclose(f);";
source = "}";
source = "Window_angle = angle;";
inputs = { name = angle; type = "int"; };
