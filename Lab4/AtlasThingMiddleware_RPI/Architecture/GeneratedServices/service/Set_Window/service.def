autogen definitions service;
library = "#include <wiringPi.h>";
output = { name = Opens_window; type = "int"; };
name = Set_Window;
source = "int applyAngle = angle;";
source = "if (applyAngle < 0) applyAngle = 0;";
source = "if (applyAngle > 50) applyAngle = 50;";
source = "wiringPiSetupGpio();";
source = "pinMode(18, PWM_OUTPUT);";
source = "pwmSetMode(PWM_MODE_MS);";
source = "pwmSetClock(192);";
source = "pwmSetRange(2000);";
source = "pwmWrite(18, 150 + (applyAngle * 200) / 180);";
source = "FILE* f = fopen(\"/tmp/window_angle\", "w");";
source = "if (f != NULL) {";
source = "    fprintf(f, \"%d\", applyAngle);";
source = "    fclose(f);";
source = "}";
inputs = { name = angle; type = "int"; };
