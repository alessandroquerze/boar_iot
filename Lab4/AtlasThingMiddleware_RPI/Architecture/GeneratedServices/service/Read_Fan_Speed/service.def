autogen definitions service;
output = { name = Fan_speed; type = "int"; };
name = Read_Fan_Speed;
source = "#define FAN_MAX_PCT 75";
source = "int value = 0;";
source = "FILE* f = fopen(\"/tmp/fan_speed\", \"r\");";
source = "if (f != nullptr) {";
source = "    if (fscanf(f, \"%d\", &value) != 1) value = 0;";
source = "    fclose(f);";
source = "}";
source = "if (value < 0) value = 0;";
source = "if (value > FAN_MAX_PCT) value = FAN_MAX_PCT;";
source = "Fan_speed = value;";
