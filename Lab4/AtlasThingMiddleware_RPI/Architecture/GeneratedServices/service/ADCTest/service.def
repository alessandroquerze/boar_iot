autogen definitions service;
library = "#include <wiringPi.h>";
output = { name = value; type = "int"; };
source = "static bool adc_initialized = false;\n";
library = "#include <wiringPiSPI.h>";
source = "#define SPI_CHANNEL 0\n";
source = "#define SPI_SPEED 1350000\n";
source = "if (!adc_initialized) {\n";
source = "    if (wiringPiSetup() == -1) {\n";
source = "        value = -1;\n";
source = "        return (void*)&value;\n";
source = "    }\n";
source = "    if (wiringPiSPISetup(SPI_CHANNEL, SPI_SPEED) == -1) {\n";
source = "        value = -1;\n";
source = "        return (void*)&value;\n";
source = "    }\n";
source = "    adc_initialized = true;\n";
source = "}\n";
source = "int mcpRead0 = 0;\n";
source = "unsigned char buffer_mcpRead0[3] = {1, (8 + 0) << 4, 0};\n";
source = "wiringPiSPIDataRW(SPI_CHANNEL, buffer_mcpRead0, 3);\n";
source = "mcpRead0 = ((buffer_mcpRead0[1] & 3) << 8) + buffer_mcpRead0[2];\n";
name = ADCTest;
source = "value = mcpRead0;";
