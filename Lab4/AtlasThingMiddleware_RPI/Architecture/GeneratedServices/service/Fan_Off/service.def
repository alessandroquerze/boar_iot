autogen definitions service;
library = "#include <wiringPi.h>";
output = { type = void; };
name = Fan_Off;
source = "wiringPiSetupGpio();";
source = "pinMode(13, PWM_OUTPUT);";
source = "pwmSetMode(PWM_MODE_MS);";
source = "pwmSetClock(192);";
source = "pwmSetRange(2000);";
source = "pwmWrite(13, 0);";
source = "FILE* f = fopen(\"/tmp/fan_speed\", \"w\");";
source = "if (f != NULL) {";
source = "    fprintf(f, \"%d\", 0);";
source = "    fclose(f);";
source = "}";
