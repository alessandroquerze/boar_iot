autogen definitions service;
library = "#include <wiringPi.h>";
output = { name = Turns_on_fan; type = "int"; };
name = Fan_On;
source = "#define FAN_PIN     13";
source = "#define FAN_MAX_PCT 75";
source = "#define PWM_CLOCK  192";
source = "#define PWM_RANGE  2000";
source = "/* clamp the speed to 0-75 percent so the motor never gets full voltage */";
source = "if (speed < 0) speed = 0;";
source = "if (speed > FAN_MAX_PCT) speed = FAN_MAX_PCT;";
source = "/* hardware PWM channel 1; same clock and range as the servo on channel 0 */";
source = "wiringPiSetupGpio();";
source = "pinMode(FAN_PIN, PWM_OUTPUT);";
source = "pwmSetMode(PWM_MODE_MS);";
source = "pwmSetClock(PWM_CLOCK);";
source = "pwmSetRange(PWM_RANGE);";
source = "pwmWrite(FAN_PIN, speed * PWM_RANGE / 100);";
source = "/* remember the commanded speed: the motor cannot be read back */";
source = "FILE* f = fopen(\"/tmp/fan_speed\", \"w\");";
source = "if (f != nullptr) {";
source = "    fprintf(f, \"%d\", speed);";
source = "    fclose(f);";
source = "}";
source = "Turns_on_fan = speed;";
inputs = { name = speed; type = "int"; };
