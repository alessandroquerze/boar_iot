autogen definitions service;
library = "#include <wiringPi.h>";
output = { name = Turns_on_fan; type = "int"; };
name = Fan_On;
source = "int applySpeed = speed;";
source = "if (applySpeed < 0) applySpeed = 0;";
source = "if (applySpeed > 75) applySpeed = 75;";
source = "wiringPiSetupGpio();";
source = "pinMode(13, PWM_OUTPUT);";
source = "pwmSetMode(PWM_MODE_MS);";
source = "pwmSetClock(192);";
source = "pwmSetRange(2000);";
source = "pwmWrite(13, applySpeed * 2000 / 100);";
source = "FILE* f = fopen("/tmp/fan_speed", "w");";
source = "if (f != NULL) {";
source = "    fprintf(f, "%d", applySpeed);";
source = "    fclose(f);";
source = "}";
inputs = { name = speed; type = "int"; };
