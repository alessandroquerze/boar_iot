autogen definitions service;
library = "#include <wiringPi.h>";
output = { type = void; };
name = OperateMotor;
source = "int pinID = 18;";
source = "wiringPiSetupGpio();";
source = "pinMode(pinID,PWM_OUTPUT);";
source = "pwmSetMode(PWM_MODE_MS);";
source = "pwmSetRange(2000);";
source = "pwmSetClock(192);";
source = "     ";
source = "for(int i=0;i<180;i = i + 20){";
source = "		pwmWrite(pinID,i);";
source = "		delay(1000);";
source = "}";
source = "for(int i=180;i>0;i = i - 20){";
source = "		pwmWrite(pinID,i);";
source = "		delay(1000);";
source = "}";
