node_modules/

# The Atlas working directory holds the user's own apps, not ours. The example
# apps that ship with the IDE are force-added.
apps/*.iot

# The developer's own relationships, written next to their apps.
apps/relationships.json

# Local settings written by the server at runtime.
server/settings.local.json

# …except the two that ship with the IDE, as examples and for the demo.
!apps/AirControl.iot
!apps/NightWatch.iot
