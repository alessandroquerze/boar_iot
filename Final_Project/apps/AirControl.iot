  "format": "atlas-iot-app",
  "version": 1,
  "name": "AirControl",
  "finalized": true,
  "created": "2026-11-20T18:00:00.000Z",
  "modified": "2026-11-20T18:00:00.000Z",
  "source": "RUN  AT_BoarAirSensor.Calibrate_Sensor()\nTHEN AT_BoarAirSensor.Read_Temp(C)\nIF   AT_BoarAirSensor.Read_Temp(C) > 24 AND AT_BoarAirSensor.Read_Humidity() > 45\nDO\n     AT_BoarAirSensor.Fan_On(60)\n     AT_BoarAirSensor.Set_Window(40)\nELSE\n     AT_BoarAirSensor.Fan_Off()\n     AT_BoarAirSensor.Window_Close()\nEND",
  "layout": {}
}
